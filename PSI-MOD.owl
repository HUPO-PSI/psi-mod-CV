        <obo:IAO_0000115>A protein modification that effectively converts an L-asparagine residue to N4-hydroxymethyl-L-asparagine.</obo:IAO_0000115>
        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">144.13</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">144.0535</obo:MassMono_>
        <obo:Origin_>N</obo:Origin_>
        <obo:Source_>artifact</obo:Source_>
        <obo:TermSpec_>none</obo:TermSpec_>
        <oboInOwl:hasExactSynonym>(2S)-2-amino-4-[(hydroxymethyl)amino]-4-oxobutanoic acid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>2-amino-N4-hydroxymethylbutanediamic acid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>N(gamma)-hydroxymethylasparagine</oboInOwl:hasExactSynonym>
