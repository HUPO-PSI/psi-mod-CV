        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively converts an L-cysteine residue to (R)-5-oxo-1,4-tetrahydrothiazine-3-carboxylic acid.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">40.02</mod:DiffAvg>
        <mod:DiffFormula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 2 H 0 N 0 O 1 S 0</mod:DiffFormula>
