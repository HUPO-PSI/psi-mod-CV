        <obo:IAO_0000115>A protein modification that effectively converts a glycine residue to 2-hydroxyglycine.</obo:IAO_0000115>
        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">73.05</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">73.01638</obo:MassMono_>
        <obo:Origin_>G</obo:Origin_>
        <obo:Source_>artifact</obo:Source_>
        <obo:TermSpec_>none</obo:TermSpec_>
