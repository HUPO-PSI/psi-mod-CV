        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">6-[1-azanyl-2-sulfanylethyl]-3-hydroxypyridine-2,5-dicarboxylic acid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">L-cysteine 3-hydroxy-2,5-pyridinedicarboxylic acid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CROSSLNK 3-hydroxypyridine-2,5-dicarboxylic acid (Ser-Cys)</oboInOwl:hasRelatedSynonym>
