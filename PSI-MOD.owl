    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00033"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that crosslinks two residues by condensation of a cysteine thiol with the amido nitrogen of the following residue to form an isothiazolidinone ring.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:01861</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The isothiazolidinone ring is usually formed by the reaction of a cysteine sulfenic acid with the amido nitrogen releasing water.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isothiazolidinone ring crosslinked residues</rdfs:label>
    </owl:Class>
