        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Otc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S-carbamoylmethylcysteine cyclization (N-terminus)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyro-carbamidomethyl</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">S-carbamoylmethylcysteine cyclization (N-terminus)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:00419</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From DeltaMass: A secondary modification affecting peptides with S-carbamoylmethyl-L-cysteine (CamC) at the N-terminus. These exist in enzymatic digests of proteins that have been S-alkylated with iodoacetamide. Cyclization of N-terminal CamC gives a residue of (R)-5-oxoperhydro-1,4-thiazine-3-carboxylic acid. Peptides in which this has occurred become more hydrophobic, and lose 17 Da from the N-terminal residue.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(R)-5-oxo-1,4-tetrahydrothiazine-3-carboxylic acid</rdfs:label>
    </owl:Class>
