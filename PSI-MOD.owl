    <!-- http://purl.obolibrary.org/obo/MOD_01679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00398"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively replaces a residue alpha amino or imino hydrogen with a carbamoyl group.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">43.02</mod:DiffAvg>
