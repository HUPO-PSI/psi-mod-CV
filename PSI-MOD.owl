    <!-- http://purl.obolibrary.org/obo/MOD_01465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_01687"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/mod#derives_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MOD_01464"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively converts an L-methioninium (protonated L-methionine) residue to an N6,N6,N6-trimethyl-L-methionine.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">42.08</mod:DiffAvg>
        <mod:DiffFormula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 3 H 6 N 0 O 0 S 0</mod:DiffFormula>
        <mod:DiffMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">42.046402</mod:DiffMono>
        <mod:FormalCharge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1+</mod:FormalCharge>
        <mod:Formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 8 H 17 N 1 O 1 S 1</mod:Formula>
        <mod:MassAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">175.29</mod:MassAvg>
        <mod:MassMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">175.10254</mod:MassMono>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:001464</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural</mod:Source>
        <mod:TermSpec rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-term</mod:TermSpec>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N2Me3Met</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:01465</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/mod#PSI-MOD-slim"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For amino acids residues, amine trimethylation can effectively only be accomplished with an aminium, protonated primary amino, group. This process accounts only for trimethylation and not protonation. The alternative N2Me3+Met process (MOD:01382) accounts for both protonation and trimethylation.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N,N,N-trimethyl-L-methionine (from L-methioninium)</rdfs:label>
    </owl:Class>
