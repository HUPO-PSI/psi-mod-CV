        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_01156"/>
        <obo:IAO_0000115>A distinct molecular entity produced from a protein or a protein modification as the result of a fragmentation process.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>PSI-MOD</oboInOwl:hasOBONamespace>
