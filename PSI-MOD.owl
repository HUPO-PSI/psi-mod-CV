        <mod:MassAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">131.17</mod:MassAvg>
        <mod:MassMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">131.09409</mod:MassMono>
