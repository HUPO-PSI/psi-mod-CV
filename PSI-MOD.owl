    <!-- http://purl.obolibrary.org/obo/MOD_01454 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00750"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00915"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively crosslinks an N-terminal L-proline residue and a strand of DNA at the C-1 of a ribose, freeing the nucleotide base and forming N-(DNA-1&apos;,2&apos;-dideoxyribos-1&apos;-ylidene)-L-prolinium.</obo:IAO_0000115>
        <mod:FormalCharge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1+</mod:FormalCharge>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural</mod:Source>
        <mod:TermSpec rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-term</mod:TermSpec>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(1Z,2S)-2-carboxy-1-[(3R,4R)-3,4-dihydroxy-5-(phosphonooxy)pentylidene]pyrrolidinium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-(DNA-1&apos;,2&apos;-dideoxyribos-1&apos;-ylidene)-L-prolinium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA glycosylase proline Schiff base intermediate</oboInOwl:hasRelatedSynonym>
