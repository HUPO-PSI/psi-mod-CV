        <owl:annotatedTarget>A protein modification that effectively converts an N-terminal L-cysteine residue by a formadehyde adduct to 4-thiazolidinecarboxylic acid.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DeltaMass:342</oboInOwl:hasDbXref>
    </owl:Axiom>
