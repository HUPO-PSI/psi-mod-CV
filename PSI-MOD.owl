        <mod:MassAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">223.23</mod:MassAvg>
        <mod:MassMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">223.01773</mod:MassMono>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C, S, S</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural</mod:Source>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uniprot.ptm:PTM-0454</oboInOwl:hasDbXref>
