        <oboInOwl:id>MOD:01863</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/mod#PSI-MOD-slim"/>
        <rdfs:comment>The reagent consists of a reporter group, a balance group and a protein reactive N-oxysuccinimide group. The reporter group, an isotopically labeled 1,4-dimethylpiperazine, is connected to a carbonyl balance group that is isotopically labeled to produce a nominally isobaric combined modification.</rdfs:comment>
        <rdfs:label>mTRAQ reporter+balance reagent acylated residue</rdfs:label>
    </owl:Class>
