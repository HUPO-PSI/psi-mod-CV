        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively cross-links a cysteine and two serine residues to form L-cysteine 3-hydroxy-2,5-pyridinedicarboxylic acid.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-54.07</mod:DiffAvg>
        <mod:DiffFormula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 0 H -8 N -1 O -2 S 0</mod:DiffFormula>
