        <mod:MassAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">618.34</mod:MassAvg>
        <mod:MassMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">617.8703</mod:MassMono>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C, C, C, H</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural</mod:Source>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CDGSH domain iron-sulfur cluster</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">METAL Iron-sulfur (2Fe-2S)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">METAL Iron-sulfur (2Fe-2S); via pros nitrogen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">di-mu-sulfido(bis-S-cysteinyliron)(S-cysteinyl-N3&apos;-histidinoiron)</oboInOwl:hasExactSynonym>
