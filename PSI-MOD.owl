        <mod:MassMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">144.01192</mod:MassMono>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artifact</mod:Source>
        <mod:TermSpec rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-term</mod:TermSpec>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unimod:26</oboInOwl:hasDbXref>
