        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hypothetical</mod:Source>
        <mod:TermSpec rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-term</mod:TermSpec>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unimod:299</oboInOwl:hasDbXref>
