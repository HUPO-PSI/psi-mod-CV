    <!-- http://purl.obolibrary.org/obo/MOD_01679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00398"/>
        <obo:DiffAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">43.02</obo:DiffAvg_>
