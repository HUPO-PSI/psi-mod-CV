        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:01802</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/mod#PSI-MOD-slim"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For amino acids residues, amine trimethylation can effectively only be accomplished with an aminium, protonated primary amino, group. This process accounts only for trimethylation and not protonation. The alternative N2Me3+Ser process (MOD:00071) accounts for both protonation and trimethylation.</rdfs:comment>
