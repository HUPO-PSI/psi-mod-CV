        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reduced 4-Hydroxynonenal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:00642</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">4-hydroxynonenal, a toxic lipid aldehyde, is a product of the hydroperoxide beta-cleavage degradation of omega-6 polyunsaturated fatty acids, such as arachidonic and linoleic acids [JSG].</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reduced 4-hydroxynonenal adduct</rdfs:label>
    </owl:Class>
