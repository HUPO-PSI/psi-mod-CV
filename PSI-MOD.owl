        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/mod#PSI-MOD-slim"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The reagent consists of a reporter group, a balance group and a protein reactive N-oxysuccinimide group. The reporter group, an isotopically labeled 1,4-dimethylpiperazine, is connected to a carbonyl balance group that is isotopically labeled to produce a nominally isobaric combined modification.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iTRAQ4plex reporter+balance reagent N-acylated residue</rdfs:label>
    </owl:Class>
