        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">144.17</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">144.01193</obo:MassMono_>
        <obo:Origin_>C</obo:Origin_>
        <obo:Source_>artifact</obo:Source_>
