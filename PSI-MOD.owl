        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively replaces a 1-carboxyl group (usually referred to as the alpha-carboxyl) with a carboxamido group.</owl:annotatedTarget>
