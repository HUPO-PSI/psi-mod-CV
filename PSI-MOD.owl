                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MOD_00446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification produced by formation of an adduct of a residue with 4-hydroxynonenal artificially reduced by a reagent such as NaBH4.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">158.24</mod:DiffAvg>
        <mod:DiffFormula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 9 H 18 O 2</mod:DiffFormula>
        <mod:DiffMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">158.13068</mod:DiffMono>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artifact</mod:Source>
