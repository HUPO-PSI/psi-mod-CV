        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively converts three L-cysteine residues, an L-histidine residue and a two-iron two-sulfur cluster to tris-L-cysteinyl L-histidino diiron disulfide.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">171.78</mod:DiffAvg>
