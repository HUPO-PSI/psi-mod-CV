        <obo:IAO_0000115>A protein modification that effectively converts an L-methionine residue to dehydrobutyrine, by neutral loss of methyl sulfide.</obo:IAO_0000115>
        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">83.09</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">83.03712</obo:MassMono_>
        <obo:Origin_>M</obo:Origin_>
        <obo:Source_>artifact</obo:Source_>
        <obo:TermSpec_>none</obo:TermSpec_>
        <oboInOwl:hasExactSynonym>dHAbu(Met)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MOD:01704</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/mod#PSI-MOD-slim"/>
        <rdfs:comment>It is expected that this neutral loss will produce a mix of (E)- and (Z)-isomers [JSG].</rdfs:comment>
        <rdfs:label>dehydrobutyrine (Met)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
