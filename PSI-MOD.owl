        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">171.26</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">171.14973</obo:MassMono_>
