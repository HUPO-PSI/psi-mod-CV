    <!-- http://purl.obolibrary.org/obo/MOD_00868 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_00868">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00009"/>
        <obo:IAO_0000115>A protein modification that inserts or replaces a residue with a natural, non-standard encoded residue, such as N-formyl-L-methionine, L-selenocysteine, or L-pyrrolysine.</obo:IAO_0000115>
        <obo:Origin_>X</obo:Origin_>
        <obo:Source_>natural</obo:Source_>
        <oboInOwl:hasOBONamespace>PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MOD:00868</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/mod#PSI-MOD-slim"/>
        <rdfs:comment>These are produced exclusively by modification of amino acids acylated to special tRNA before incorporation by ribosomes into proteins. For this reason, they have also been referred to as pre-translational modifications.</rdfs:comment>
