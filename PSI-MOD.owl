        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">143.14</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">143.05824</obo:MassMono_>
