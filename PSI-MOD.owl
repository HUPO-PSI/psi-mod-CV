    <!-- http://purl.obolibrary.org/obo/MOD_01014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00947"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modification from DeltaMass</obo:IAO_0000115>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X</mod:Origin>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:01014</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From DeltaMass: Average Mass: 98 Formula:H3PO4 or H2SO4 Monoisotopic Mass Change:97.97 Average Mass Change:98 Notes:Proteins may pick up non-covalent salt adducts during purification. Phosphate and sulphate salts are commonly used and may be observed as +98 amu adducts (or multiples thereof) forming ion pairs with basic residues. Monoisotopic masses H2SO4 97.967, H3PO4 97.977</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phosphate/sulphate adduct of proteins</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MOD_01014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modification from DeltaMass</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeltaMass:358</oboInOwl:hasDbXref>
    </owl:Axiom>
    


