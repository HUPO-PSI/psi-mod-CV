        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AEBSF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/mod#DeltaMass-label"/>
    </owl:Axiom>
