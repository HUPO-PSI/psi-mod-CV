    <!-- http://purl.obolibrary.org/obo/MOD_00642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_00642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_00848"/>
