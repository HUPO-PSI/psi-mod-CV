        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively replaces a residue amino- or imino-hydrogen with one of the Applied Biosystems iTRAQ4plex reagent reporter+balance groups.</obo:IAO_0000115>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artifact</mod:Source>
