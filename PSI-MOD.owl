        <obo:DiffMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.0313</obo:DiffMono_>
        <obo:Formula_>C 2 H 4</obo:Formula_>
        <obo:IAO_0000115>A protein modification that effectively replaces two alpha amino hydrogen atoms with two methyl group.</obo:IAO_0000115>
        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.05</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.0313</obo:MassMono_>
        <obo:Origin_>X</obo:Origin_>
        <obo:Source_>none</obo:Source_>
        <obo:TermSpec_>N-term</obo:TermSpec_>
