        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">73.12</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">72.99862</obo:MassMono_>
