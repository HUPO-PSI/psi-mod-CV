        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively converts an L-asparagine residue to L-aspartate 4-methyl ester.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unimod:528#N</oboInOwl:hasDbXref>
