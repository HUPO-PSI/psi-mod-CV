        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">131.17</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">131.09464</obo:MassMono_>
