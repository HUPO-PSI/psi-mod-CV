    <!-- http://purl.obolibrary.org/obo/MOD_01337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOD_01337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOD_01369"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/mod#derives_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MOD_01181"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A protein modification that effectively converts an L-asparagine residue to L-aspartate 4-methyl ester.</obo:IAO_0000115>
        <mod:DiffAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">15.01</mod:DiffAvg>
        <mod:DiffFormula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 1 H 1 N -1 O 1</mod:DiffFormula>
        <mod:DiffMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">14.999666</mod:DiffMono>
        <mod:Formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C 5 H 7 N 1 O 3</mod:Formula>
        <mod:MassAvg rdf:datatype="http://www.w3.org/2001/XMLSchema#float">129.12</mod:MassAvg>
        <mod:MassMono rdf:datatype="http://www.w3.org/2001/XMLSchema#float">129.04259</mod:MassMono>
        <mod:Origin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N</mod:Origin>
        <mod:Source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">artifact</mod:Source>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unimod:528</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PSI-MOD</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deamidation followed by a methylation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methyl+Deamidated</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOD:01337</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The deamidation and methylation of L-asparagine has not been reported as a natural modification. It is extremely unlikely that eukaryotes produce this modification, because a natural process that would form L-aspartic acid 4-methyl ester from either L-aspartic acid or L-asparagine would interfere with the D-aspartyl peptide repair mechanism [JSG].</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deamidated 4-methyl esterified asparagine</rdfs:label>
    </owl:Class>
