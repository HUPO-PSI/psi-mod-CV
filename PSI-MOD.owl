        <obo:DiffMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">42.04695</obo:DiffMono_>
        <obo:FormalCharge_>1+</obo:FormalCharge_>
        <obo:Formula_>C 5 H 11 N 1 O 1</obo:Formula_>
        <obo:IAO_0000115>A protein modification that effectively converts a glycinium (protonated glycine) residue to an N,N,N-trimethylglycine.</obo:IAO_0000115>
        <obo:MassAvg_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">101.15</obo:MassAvg_>
        <obo:MassMono_ rdf:datatype="http://www.w3.org/2001/XMLSchema#float">101.08406</obo:MassMono_>
